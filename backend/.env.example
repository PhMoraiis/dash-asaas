# Database
DATABASE_URL="postgresql://dashboard:dashboard123@localhost:5432/dashboard_webhooks"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

COOKIE_SECRET="your-secret-token-cookies"

# Server
NODE_ENV="development"
PORT=3333
API_VERSION="v1"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Asaas Webhook
ASAAS_WEBHOOK_SECRET="your-asaas-webhook-secret"

# External System Integration
EXTERNAL_API_URL="https://your-external-system.com"
EXTERNAL_API_TOKEN="your-external-api-token"

RESEND_API_URL="your-resend-api-key"
