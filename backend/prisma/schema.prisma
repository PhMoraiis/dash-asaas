// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String // E-mail do usuário (admin ou revenda)
  userType  String // "admin" ou "revenda"
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Admin {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  slug               String   @unique
  mustChangePassword Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("admins")
}

model Revenda {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  slug               String   @unique
  mustChangePassword Boolean  @default(true)
  webhookToken       String   @unique @default(cuid())
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relacionamentos
  produtos   Produto[]
  webhooks   Webhook[]
  userCharts UserChart[]

  @@map("revendas")
}

model Produto {
  id           String   @id @default(cuid())
  name         String
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  webhookToken String   @unique @default(uuid())

  // Relacionamentos
  revendaId String
  revenda   Revenda   @relation(fields: [revendaId], references: [id], onDelete: Cascade)
  webhooks  Webhook[]

  @@map("produtos")
}

model Webhook {
  id           String   @id @default(cuid())
  payload      Json // Dados completos do webhook
  retryCount   Int      @default(0)
  maxRetries   Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  asaasEventId String?  @unique

  // Relacionamentos
  revendaId String
  revenda   Revenda @relation(fields: [revendaId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([revendaId])
  @@index([produtoId])
  @@index([createdAt])
  @@map("webhooks")
}

model UserChart {
  id        String   @id @default(cuid())
  revendaId String
  revenda   Revenda  @relation(fields: [revendaId], references: [id], onDelete: Cascade)
  nome      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_charts")
}
